{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/redtrades/agent-platform/blob/main/tools/adapters/reviewer/child-review-result.schema.json",
  "title": "Agent Platform child reviewer result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "verdict",
    "candidate_sha",
    "reviewer_run_id",
    "reviewer_family",
    "author_family",
    "findings",
    "acceptance_evidence",
    "attempts"
  ],
  "properties": {
    "schema": {
      "const": "agent-platform.child-review-result/v1"
    },
    "verdict": {
      "enum": ["pass", "needs-fix", "reject"]
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reviewer_run_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_family": {
      "const": "codex"
    },
    "author_family": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "description"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "acceptance_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "candidate_sha"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "attempts": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
