{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AISDLC Claim Payload",
  "description": "Neutral JSON Schema mirroring the TypeScript claim contract for validation by CI and Python workers.",
  "type": "object",
  "required": ["issue", "owner", "paths", "headSha", "phase"],
  "properties": {
    "issue": {
      "type": "string",
      "pattern": "^[1-9]\\d*$",
      "description": "Positive integer issue identifier."
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+/[a-z0-9._-]+$",
      "description": "Durable session owner in `harness/session` form."
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Non-empty array of repository paths governed by the claim."
    },
    "headSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "40-character lowercase hex SHA of the exact candidate."
    },
    "phase": {
      "type": "string",
      "enum": [
        "sdlc:implement",
        "sdlc:awaiting-ci",
        "sdlc:review",
        "sdlc:repair",
        "sdlc:merge",
        "sdlc:blocked",
        "sdlc:done"
      ],
      "description": "Current lifecycle phase from the AISDLC contract."
    },
    "command": {
      "type": "string",
      "enum": ["claim", "release"],
      "default": "claim",
      "description": "Claim command action. Defaults to `claim` when omitted."
    }
  },
  "additionalProperties": false
}
